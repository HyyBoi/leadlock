# Postgres (Neon free tier works). Use the pooled connection string.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Public base URL of the deployment (used for webhooks, OAuth redirect, links in alerts). No trailing slash.
APP_URL="https://leadlock.onrender.com"
# 32+ random characters. Encrypts integration secrets and OAuth tokens at rest. `openssl rand -hex 32`
ENCRYPTION_KEY=""
# Google Cloud OAuth client (Web application). Redirect URI: $APP_URL/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
